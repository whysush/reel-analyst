{
  "manifest_version": 3,
  "name": "Reel Analyst",
  "version": "1.0",

  "browser_specific_settings": {
    "gecko": {
      "id": "reelanalyst@example.com"
    }
  },

  "background": {
    "scripts": ["background.js"]
},

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://www.instagram.com/*",
    "https://openrouter.ai/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
  {
    "matches": [
      "*://*.instagram.com/*"
    ],

    "js": [
      "content.js"
    ]
  }
]
}
